# ==============================================================================
# ZiroCredit Environment Variables Configuration
# ==============================================================================
# The prototype runs 100% locally out-of-the-box with deterministic AI fallback
# and zero external API dependencies or costs required.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000

# Optional External LLM Provider Keys (Provider-Independent Interface)
# If left blank, ZiroCredit utilizes its built-in deterministic rule-bound AI engine.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Local SQLite Database Path
DATABASE_PATH=./data/ziro_credit.db

# Mock Credit Bureau Settings
MOCK_BUREAU_NAME="Apex Mock Credit Bureau (Simulation Only)"
MOCK_BUREAU_BASE_URL="mock://apex-bureau.local/v1"
